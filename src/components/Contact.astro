---
// Per Nick's brief: no form. Contact details presented clearly and
// professionally — approachable and personal, not promotional.
//
// Type sizes brought onto the same scale as the rest of the site: the
// details were noticeably smaller than the body copy elsewhere, which broke
// the editorial hierarchy at the foot of the page.
const details = [
  {
    label: "Address",
    lines: [
      "Ascendiate Pte. Ltd.",
      "22 Sin Ming Lane",
      "#06-76 Midview City",
      "Singapore 573969",
    ],
  },
  {
    label: "Telephone",
    href: "tel:+6569570175",
    lines: ["+65 6957 0175"],
  },
  {
    label: "Email",
    href: "mailto:info@ascendiate.com",
    lines: ["info@ascendiate.com"],
  },
];
---

<section id="contact" class="py-24 lg:py-32">
  <div class="mx-auto max-w-canvas px-6 md:px-12 lg:px-24">
    <!-- Section header, consistent with About, Approach and Mandates -->
    <div class="section-header text-[1rem] tracking-[0.1em] text-blue">
      Contact
      <span class="mt-3 block h-[3px] w-12 bg-blue"></span>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-14 lg:grid-cols-[1.35fr_1fr] lg:gap-24">
      <h2 class="lead-statement max-w-[34ch]" data-reveal>
        Ascendiate welcomes the opportunity to discuss how it can help create,
        preserve or unlock value.
      </h2>

      <address class="not-italic" data-reveal>
        <dl class="flex flex-col gap-9">
          {
            details.map((d) => (
              <div>
                <dt class="block-heading">{d.label}</dt>
                <dd class="mt-4">
                  {d.href ? (
                    <a
                      href={d.href}
                      class="supporting-text font-normal transition-colors hover:text-blue"
                    >
                      {d.lines[0]}
                    </a>
                  ) : (
                    <span class="supporting-text block font-normal leading-[1.7]">
                      {d.lines.map((line, i) => (
                        <>
                          {i > 0 && <br />}
                          {line}
                        </>
                      ))}
                    </span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </address>
    </div>
  </div>
</section>
