---
// Per Nick's brief: no form. Contact details presented clearly and
// professionally — approachable and personal, not promotional.
---

<section id="contact" class="mx-auto max-w-canvas px-6 py-20 md:px-12 lg:px-24 lg:py-24">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[180px_1fr_1fr] lg:gap-24">
    <div class="section-header">Contact</div>

    <div data-reveal>
      <h2
        class="max-w-[520px] font-sans text-[clamp(1.75rem,3vw,38px)] font-medium leading-[1.2] tracking-[-0.02em] text-ink"
      >
        Ascendiate welcomes the opportunity to discuss how it can help create, preserve or unlock
        value.
      </h2>
    </div>

    <address class="not-italic" data-reveal>
      <dl class="flex flex-col gap-8">
        <div class="flex gap-6">
          <dt class="section-label min-w-24 pt-0.5">Address</dt>
          <dd class="text-[15px] not-italic leading-[1.6] text-ink">
            Ascendiate Pte. Ltd.<br />
            22 Sin Ming Lane<br />
            #06-76 Midview City<br />
            Singapore 573969
          </dd>
        </div>
        <div class="flex gap-6">
          <dt class="section-label min-w-24 pt-0.5">Telephone</dt>
          <dd>
            <a href="tel:+6569570175" class="text-[15px] text-ink transition-colors hover:text-blue">
              +65 6957 0175
            </a>
          </dd>
        </div>
        <div class="flex gap-6">
          <dt class="section-label min-w-24 pt-0.5">Email</dt>
          <dd>
            <a
              href="mailto:info@ascendiate.com"
              class="text-[15px] text-ink transition-colors hover:text-blue"
            >
              info@ascendiate.com
            </a>
          </dd>
        </div>
      </dl>
    </address>
  </div>
</section>
