---
import EditorialImage from "./EditorialImage.astro";

/**
 * Mandates — formerly Experience. Rebuilt to Nick's refinement brief.
 *
 * Not six equal cards: a single central architectural image acts as the
 * organising anchor, with the mandates arranged either side reading as six
 * pieces of evidence supporting one proposition. Each leads with the
 * commercial outcome; the supporting evidence is deliberately short.
 *
 * Copy is Nick's revised wording, which is materially shorter than the
 * previous version and revises some figures.
 */
const left = [
  {
    outcome: "Enabled IPO readiness",
    evidence: [
      "Restructured USD4bn across 24 facilities with 14 lenders.",
      "Prepared a leading Middle Eastern airline for IPO.",
    ],
  },
  {
    outcome: "Preserved business continuity",
    evidence: [
      "Directed a USD1.1bn restructuring and refinancing across 12 lenders.",
      "Stabilised a publicly listed company throughout COVID-19.",
    ],
  },
  {
    outcome: "Optimised hedging strategy",
    evidence: [
      "Delivered c.USD300m of fuel hedging savings.",
      "Strengthened treasury capability for a leading Middle Eastern airline.",
    ],
  },
];

const right = [
  {
    outcome: "Achieved 20% portfolio growth",
    evidence: [
      "Expanded a publicly listed aircraft lessor’s portfolio by USD300m.",
      "Structured 11 aircraft investments involving 8 customers and 7 lenders.",
    ],
  },
  {
    outcome: "Improved cash collection by 70%",
    evidence: [
      "Accelerated cash collection by over 70%.",
      "Transformed payment operations for an investment-grade enterprise.",
    ],
  },
  {
    outcome: "Shaped a USD1.25bn takeover bid",
    evidence: [
      "Directed transaction structuring and risk evaluation for a private equity consortium.",
      "Materially influenced the decision not to proceed.",
    ],
  },
];
---

<section id="work" class="py-24 lg:py-32">
  <div class="mx-auto max-w-canvas px-6 md:px-12 lg:px-24">
    <!-- Centred header: section heading, lead statement, supporting statement -->
    <div class="mx-auto flex max-w-[860px] flex-col items-center text-center" data-reveal>
      <div class="section-header text-[1rem] tracking-[0.1em] text-blue">
        Mandates
      </div>
      <h2
        class="mt-6 font-sans text-[clamp(2rem,4vw,3.25rem)] font-semibold leading-[1.12] tracking-[-0.03em] text-ink"
      >
        Trusted where outcomes matter most.
      </h2>
      <span class="mt-7 block h-[3px] w-12 bg-blue"></span>
      <p class="supporting-text mt-6 font-normal text-mid">
        Creating, preserving and unlocking value.
      </p>
    </div>

    <!-- The composition: central image anchor, mandates either side.
         On smaller screens this unwinds to a single column with the image
         leading, so the anchor is still the first thing seen. -->
    <div
      class="mt-16 grid grid-cols-1 items-center gap-x-16 gap-y-12 lg:mt-24 lg:grid-cols-[1fr_minmax(360px,1.05fr)_1fr] lg:gap-x-16"
    >
      <!-- Central anchor — first in source order so it leads on mobile -->
      <div class="lg:order-2" data-reveal>
        <EditorialImage
          ratio="portrait"
          note="Central anchor — symmetry, perspective, vanishing point"
        />
      </div>

      <!-- Left column -->
      <div class="space-y-12 lg:order-1 lg:space-y-16 lg:text-right">
        {
          left.map((m) => (
            <article data-reveal>
              <h3 class="font-sans text-[clamp(1.125rem,1.5vw,1.375rem)] font-medium leading-[1.3] tracking-[-0.015em] text-ink">
                {m.outcome}
              </h3>
              <div class="mt-4 space-y-2.5">
                {m.evidence.map((line) => (
                  <p class="body-text">{line}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <!-- Right column -->
      <div class="space-y-12 lg:order-3 lg:space-y-16">
        {
          right.map((m) => (
            <article data-reveal>
              <h3 class="font-sans text-[clamp(1.125rem,1.5vw,1.375rem)] font-medium leading-[1.3] tracking-[-0.015em] text-ink">
                {m.outcome}
              </h3>
              <div class="mt-4 space-y-2.5">
                {m.evidence.map((line) => (
                  <p class="body-text">{line}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
