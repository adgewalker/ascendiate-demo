---
// Six examples from Nick's brief, organised by theme. They read as a connected
// body of evidence — outcome-led, sentence case, no client names, no timelines.
// Order within each: Theme · Headline (the outcome) · Customer · Description.
const examples = [
  {
    theme: "Growth",
    headline: "Achieved 20% annual portfolio growth",
    customer: "Aircraft lessor",
    description:
      "Delivered USD 300m of portfolio expansion through the acquisition, financing and leasing of 11 aircraft to 8 airlines involving 7 lenders.",
  },
  {
    theme: "Liquidity and capital structure",
    headline: "Enabled IPO readiness",
    customer: "Airline",
    description:
      "Directed the refinancing of USD 4bn across 24 financing facilities involving 14 financiers, forming a key part of the airline’s broader IPO readiness programme and establishing a more scalable capital structure.",
  },
  {
    theme: "Value preservation",
    headline: "Protected liquidity through global disruption",
    customer: "Aircraft lessor",
    description:
      "Structured and implemented a portfolio-wide USD 1.1bn restructuring and refinancing that preserved liquidity and protected long-term value throughout the COVID-19 period.",
  },
  {
    theme: "Operational improvement",
    headline: "Improved cash collection and working capital performance by 70%",
    customer: "Airline",
    description:
      "Redesigned payment acceptance and processing frameworks, accelerating cash collection and delivering funding-cost savings of approximately USD 10m per annum.",
  },
  {
    theme: "Strategic transformation",
    headline: "Enhanced hedging strategy and liquidity efficiency",
    customer: "Airline",
    description:
      "Expanded derivatives capability to optimise hedging strategy and liquidity efficiency, achieving material savings (including c.USD 150m from fuel hedging).",
  },
  {
    theme: "New business creation",
    headline: "Established a new source of revenue growth",
    customer: "Aircraft lessor",
    description:
      "Developed the operating model and commercial framework required to launch and scale a new engine leasing business division.",
  },
];
---

<section id="work" class="mx-auto max-w-canvas px-6 py-20 md:px-12 lg:px-24 lg:py-24">
  <!-- Centred heading + supporting statement -->
  <div class="mb-16 flex flex-col items-center text-center lg:mb-20" data-reveal>
    <div class="section-label">Experience</div>
    <h2
      class="mt-5 max-w-[720px] font-sans text-[clamp(1.5rem,2.5vw,34px)] font-medium leading-[1.25] tracking-[-0.02em] text-ink"
    >
      Creating, preserving and unlocking value.
    </h2>
  </div>

  <!-- Six examples — two-column grid, three rows -->
  <div class="grid grid-cols-1 gap-x-24 gap-y-14 md:grid-cols-2 lg:gap-y-16">
    {
      examples.map((e) => (
        <article class="border-t border-hairline-light pt-8" data-reveal>
          <div class="section-label">{e.theme}</div>
          <h3 class="mt-4 font-sans text-[clamp(1.25rem,1.6vw,24px)] font-medium leading-[1.25] tracking-[-0.01em] text-ink">
            {e.headline}
          </h3>
          <div class="mt-3 text-[13px] tracking-[0.02em] text-mid">{e.customer}</div>
          <p class="mt-4 max-w-[460px] font-serif text-[16px] leading-[1.65] text-body">
            {e.description}
          </p>
        </article>
      ))
    }
  </div>
</section>
