---
import EditorialImage from "./EditorialImage.astro";

/**
 * About — rebuilt to Nick's refinement brief.
 *
 * Three blocks read as one narrative, each with four clearly separated
 * editorial levels: block heading, lead statement, supporting text, body
 * text. The lead statement dominates; everything below steps down in size,
 * weight and colour. Blocks alternate sides to move the eye down the page.
 */
const blocks = [
  {
    heading: "Challenge",
    lead: "Organisations operate in constantly evolving environments.",
    supporting:
      "Priorities shift. Organisations grow. Markets change. New challenges emerge.",
    body: [
      "As objectives evolve, organisations do not always adapt at the same pace.",
      "The expertise and perspectives needed to respond rarely sit in one place. They are often shaped by competing priorities and constraints.",
    ],
    imageNote: "Architectural — structure, light",
    imageSide: "left" as const,
  },
  {
    heading: "Route forward",
    lead: "Achieving successful outcomes requires more than expertise alone.",
    supporting:
      "Priorities compete. Constraints emerge. Decisions become harder. Opportunities are missed.",
    body: [
      "Achieving those outcomes begins with understanding what leadership is seeking to achieve and what may be preventing progress.",
      "Reconciling divergent priorities and constraints creates direction, builds momentum and delivers tangible results.",
    ],
    imageNote: "Architectural — perspective, direction",
    imageSide: "right" as const,
  },
  {
    heading: "Ascendiate",
    lead: "Delivering today’s objectives. Strengthening tomorrow’s organisation.",
    supporting: null,
    body: [
      "Ascendiate is an independent platform that transforms competing priorities into clear direction and momentum.",
      "Its value lies not only in achieving today’s objectives, but also in building the organisational capability required to address tomorrow’s challenges.",
    ],
    imageNote: "Architectural — integration, resolution",
    imageSide: "left" as const,
  },
];
---

<section id="about" class="py-24 lg:py-32">
  <div class="mx-auto max-w-canvas px-6 md:px-12 lg:px-24">
    <!-- Section header + supporting statement -->
    <div class="max-w-[900px]">
      <div class="section-header text-[1rem] tracking-[0.1em] text-blue">
        About
        <span class="mt-3 block h-[3px] w-12 bg-blue"></span>
      </div>
      <h2
        class="mt-6 font-sans text-[clamp(2rem,4vw,3.25rem)] font-semibold leading-[1.12] tracking-[-0.03em] text-ink"
        data-reveal
      >
        Creating, growing and stabilising businesses. Building stronger
        organisations.
      </h2>
    </div>

    <!-- Editorial blocks, alternating sides -->
    <div class="mt-20 space-y-24 lg:mt-28 lg:space-y-32">
      {
        blocks.map((block) => (
          <div
            class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-20"
            data-reveal
          >
            <EditorialImage
              note={block.imageNote}
              class:list={[block.imageSide === "right" && "lg:order-2"]}
            />

            <div class:list={[block.imageSide === "right" && "lg:order-1"]}>
              <div class="block-heading">{block.heading}</div>

              <h3 class="lead-statement mt-6 max-w-[30ch]">{block.lead}</h3>

              {block.supporting && (
                <p class="supporting-text mt-5 max-w-[46ch]">
                  {block.supporting}
                </p>
              )}

              {block.supporting && <div class="editorial-divider max-w-[46ch]" />}
              {!block.supporting && <div class="mt-7" />}

              <div class="max-w-[52ch]">
                {block.body.map((para) => (
                  <p class="body-text">{para}</p>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
