---
// Copy from Nick's brief. Editorial, not card-based: the three passages
// (Challenge / Route forward / Ascendiate) read as a connected narrative,
// distinguished through typography, spacing and rhythm rather than panels.
const passages = [
  {
    label: "Challenge",
    body: "Organisations rarely struggle because they lack ambition, expertise or opportunity. The challenge is rarely the destination itself, but bringing together competing stakeholder interests to create the pathway from idea to outcome. The strongest outcomes do more than solve the immediate challenge. They strengthen organisations.",
  },
  {
    label: "Route forward",
    body: "Progress requires distinguishing the issues that matter most and focusing effort on the decisions that will shape the outcome. The expertise and perspectives required to turn vision into reality rarely sit in one place and are often shaped by conflicting priorities and constraints. Realising that vision requires reconciling these often divergent dynamics in a way that creates direction, builds momentum and delivers tangible results.",
  },
  {
    label: "Ascendiate",
    body: "Ascendiate is an independent platform created to turn competing priorities into clear direction and momentum, transforming goals into achievement. Ascendiate’s value is not only to achieve today’s objectives, but also to build the organisational capability required to address tomorrow’s challenges.",
  },
];
---

<section id="about" class="mx-auto max-w-canvas px-6 py-20 md:px-12 lg:px-24 lg:py-24">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[180px_1fr] lg:gap-24">
    <div class="section-label">About</div>

    <div>
      <!-- Supporting statement — subordinate to nothing but the heading. -->
      <h2
        class="max-w-[760px] font-sans text-[clamp(1.75rem,3vw,40px)] font-medium leading-[1.2] tracking-[-0.02em] text-ink"
        data-reveal
      >
        Creating, growing and stabilising businesses. Building stronger organisations.
      </h2>

      {/*
        ATMOSPHERIC VISUAL — placeholder. Nick wants one restrained, conceptual
        element reinforcing connection / pathways / convergence (not aviation,
        not the gradient placeholder). Secondary to the content. TODO: design + add.
      */}

      <!-- Connected narrative: subtle labels, flowing prose. -->
      <div class="mt-14 max-w-[760px] space-y-12">
        {
          passages.map((p) => (
            <div class="grid grid-cols-1 gap-x-12 gap-y-3 md:grid-cols-[160px_1fr]" data-reveal>
              <div class="section-label pt-1.5">{p.label}</div>
              <p class="font-serif text-[18px] leading-[1.7] text-body">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
