---
/**
 * Atmospheric gradient placeholder standing in for a hero/horizon photo.
 * Ported from the concept's <SkyImage>. Swap for a real <img> when assets land.
 */
type Tone = "warm" | "cool" | "dusk" | "paper";

interface Props {
  tone?: Tone;
  label?: string;
  motion?: boolean;
  class?: string;
}

const { tone = "warm", label = "Atmospheric horizon", motion = false, class: className = "" } = Astro.props;

const palettes: Record<Tone, { top: string; mid: string; low: string; accent: string }> = {
  warm: { top: "#d9cdb8", mid: "#c2b7a4", low: "#a89e8d", accent: "#7d735f" },
  cool: { top: "#c3cedb", mid: "#a8b6c6", low: "#8898ad", accent: "#5d6c81" },
  dusk: { top: "#3a4452", mid: "#2a3340", low: "#1c232e", accent: "#4d5b70" },
  paper: { top: "#e8e2d4", mid: "#d6cdb9", low: "#c0b7a1", accent: "#8d8470" },
};

const p = palettes[tone];
// Stable, unique gradient id per render to avoid collisions across instances.
const id = `sky-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="0 0 1632 620"
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  class:list={["block h-full w-full", motion && "hero-img-motion", className]}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={p.top} />
      <stop offset="55%" stop-color={p.mid} />
      <stop offset="100%" stop-color={p.low} />
    </linearGradient>
  </defs>
  <rect width="1632" height="620" fill={`url(#${id})`}></rect>
  {
    label && (
      <text
        x="1608"
        y="598"
        text-anchor="end"
        font-family="'Inter', sans-serif"
        font-size="11"
        fill={p.accent}
        fill-opacity="0.55"
        letter-spacing="0.18em"
      >
        {label}
      </text>
    )
  }
</svg>
