---
import EditorialImage from "./EditorialImage.astro";

interface Props {
  /** Real photograph for the hero slot. Omit for the placeholder version. */
  image?: string;
  imageAlt?: string;
  /** Crop focus, so the meaningful part of the photograph stays in frame. */
  imagePosition?: string;
}
const { image, imageAlt = "", imagePosition } = Astro.props;

/**
 * Hero — rebuilt to Nick's refinement brief and rough visualisation.
 *
 * Split composition: text on the light left half, image on the right. This
 * keeps the light/dark contrast Nick wanted to retain, but rearranges it so
 * the headline sits on paper rather than over the image — which is what his
 * visualisation shows and what lets the typography lead.
 *
 * Copy changes: eyebrow removed entirely (the headline does the work), new
 * supporting description, CTA now reads Mandates.
 *
 * The previous conceptual artwork (converging pathways) has been retired —
 * it read as aviation and digital networks, which is the association the
 * repositioning moves away from.
 */
---

<section class="border-b border-hairline-light">
  <div
    class="mx-auto grid max-w-canvas grid-cols-1 items-stretch lg:grid-cols-[1.5fr_1fr]"
  >
    <!-- Text half -->
    <div
      class="flex flex-col justify-center px-6 py-20 md:px-12 lg:px-24 lg:py-32"
    >
      <h1
        class="max-w-[16ch] font-sans text-[clamp(2.75rem,5.4vw,4.75rem)] font-semibold leading-[1.02] tracking-[-0.035em] text-ink"
      >
        Shaping vision into value.
      </h1>

      <p class="mt-9 max-w-[42ch] text-[clamp(1.0625rem,1.4vw,1.25rem)] font-light leading-[1.55] text-mid">
        Independent judgement that aligns priorities, shapes decisions and
        leaves organisations stronger.
      </p>

      <div class="mt-11">
        <a
          href="#work"
          class="btn-ink inline-block px-8 py-[16px] text-[14px] tracking-[0.02em]"
        >
          Mandates
        </a>
      </div>
    </div>

    <!-- Image half — full-bleed to the right edge of the canvas -->
    <div class="min-h-[340px] lg:min-h-[600px]">
      <EditorialImage
        class="h-full"
        ratio="fill"
        src={image}
        alt={imageAlt}
        position={imagePosition}
        note="Contemporary architecture — light, geometry, considered judgement"
      />
    </div>
  </div>
</section>
