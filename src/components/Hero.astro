---
import HeroArtwork from "./HeroArtwork.astro";
// Copy from Nick's brief. Headline is the dominant element; eyebrow is the
// smallest text; supporting description is subordinate to the headline.
// Imagery is a conceptual treatment (HeroArtwork, from Claude Design) — pathways
// converging on a point of light: direction, momentum, ascent.
---

<section class="mx-auto max-w-canvas px-6 pt-16 md:px-12 lg:px-24">
  <!-- Hero graphic with overlay -->
  <hero-drift class="relative block h-[420px] overflow-hidden md:h-[520px] lg:h-[620px]">
    <div data-drift-target class="absolute inset-0">
      <HeroArtwork />
    </div>
    <!-- Darkens the lower band for headline legibility while letting the
         convergence glow on the upper-right read through. -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to top, rgb(15 23 40 / 0.78) 0%, rgb(15 23 40 / 0.45) 28%, rgb(15 23 40 / 0.05) 58%, transparent 80%);"
    >
    </div>
    <div class="absolute inset-x-8 bottom-10 md:inset-x-16 md:bottom-14">
      <div class="mb-7 font-sans text-[12px] font-medium tracking-[0.06em] text-white/70">
        Trusted partner to leadership teams
      </div>
      <h1
        class="max-w-[1080px] font-sans font-semibold leading-[1.04] tracking-[-0.025em] text-white text-[clamp(2.5rem,7vw,88px)]"
      >
        Shaping vision into value
      </h1>
    </div>
  </hero-drift>

  <!-- Supporting description + CTA -->
  <div class="grid grid-cols-1 items-end gap-10 py-14 lg:grid-cols-[1.1fr_1fr] lg:gap-24 lg:pb-22">
    <p class="max-w-[560px] text-[20px] leading-[1.55] text-ink">
      Guiding strategic transactions, restructurings and operational improvement across the
      aviation sector.
    </p>
    <div class="flex items-center lg:justify-self-end">
      <a href="#work" class="btn-ink px-7 py-[15px] text-[14px] tracking-[0.01em]"> Experience </a>
    </div>
  </div>
</section>

<script>
  import "../scripts/HeroDrift";
</script>
