---
/**
 * Logo lockup (mark + wordmark) served as a raster asset. Sized via the
 * `size` prop; the image preserves its own aspect ratio.
 */
interface Props {
  size?: "sm" | "md";
  class?: string;
}

const { size = "md", class: className = "" } = Astro.props;

// Heights tuned to roughly match the previous wordmark cap height.
const heightClass = size === "sm" ? "h-6" : "h-9";
---

<a href="#top" class:list={["inline-flex items-center", className]}>
  <img
    src="/ascendiate-logo.png"
    alt="Ascendiate"
    class:list={["block w-auto", heightClass]}
    width="524"
    height="174"
  />
</a>
